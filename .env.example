# Database
MONGODB_URI=mongodb://localhost:27017/eikona
# or for production: mongodb+srv://username:password@cluster.mongodb.net/eikona

# JWT
JWT_SECRET_KEY=our-super-secret-jwt-key-here-make-it-long-and-random

# Cloudinary
CLOUDINARY_CLOUD_NAME=our-cloudinary-cloud-name
CLOUDINARY_API_KEY=our-cloudinary-api-key
CLOUDINARY_API_SECRET=our-cloudinary-api-secret

# Server
PORT=3000
NODE_ENV=production

# Client URL (for CORS)
CLIENT_URL=https://our-domain.com