<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eikona - Profile</title>
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    <link rel="stylesheet" href="/output.css" />

    <style>
      body {
        background: radial-gradient(ellipse at top left, #1f1c2c, #0f0c29);
        display: flex;
        min-height: 100vh;
      }
      .glass {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        width: 280px;
        z-index: 50;
        transition: transform 0.3s ease;
      }
      .main-content {
        margin-left: 280px;
        flex-grow: 1;
        padding: 2rem;
        width: calc(100% - 280px);
      }
      @media (max-width: 768px) {
        .sidebar {
          transform: translateX(-100%);
        }
        .sidebar.open {
          transform: translateX(0);
        }
        .main-content {
          margin-left: 0;
          width: 100%;
        }
      }
      .post-card {
        transition: all 0.3s ease;
        animation: fadeInUp 0.6s ease-out;
      }
      .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 35px rgba(99, 102, 241, 0.2);
      }
      .modal {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(12px);
        animation: fadeIn 0.3s ease-out;
      }
      .modal-content {
        background: rgba(31, 28, 44, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        animation: scaleIn 0.3s ease-out;
      }
      .action-btn {
        transition: all 0.2s ease;
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
      }
      .action-btn:hover {
        transform: translateY(-2px);
      }
      .action-btn::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.2),
          transparent
        );
        transition: left 0.3s;
      }
      .action-btn:hover::before {
        left: 100%;
      }
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
      }
      @media (max-width: 768px) {
        .posts-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
      }
      .post-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 0.75rem;
        margin-bottom: 1rem;
        transition: transform 0.3s ease;
      }
      .post-image:hover {
        transform: scale(1.02);
      }
      .image-wrapper {
        position: relative;
        width: 100%;
        height: 220px;
        border-radius: 0.75rem;
        overflow: hidden;
        margin-bottom: 1rem;
        background: linear-gradient(
          90deg,
          #2a2a3d 25%,
          #3b3b52 37%,
          #2a2a3d 63%
        );
        background-size: 400% 100%;
        animation: shimmer 1.5s infinite;
      }

      /* Logo animation */
      .logo-text {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientShift 3s ease-in-out infinite;
      }

      @keyframes gradientShift {
        0%,
        100% {
          background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
          background-clip: text;
          -webkit-background-clip: text;
        }
        50% {
          background: linear-gradient(135deg, #764ba2 0%, #f093fb 100%);
          background-clip: text;
          -webkit-background-clip: text;
        }
      }

      @keyframes shimmer {
        0% {
          background-position: 200% 0;
        }
        100% {
          background-position: -200% 0;
        }
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @keyframes scaleIn {
        from {
          opacity: 0;
          transform: scale(0.9);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* Profile header enhancement */
      .profile-header {
        background: linear-gradient(
          135deg,
          rgba(99, 102, 241, 0.1) 0%,
          rgba(139, 92, 246, 0.1) 100%
        );
        animation: slideDown 0.8s ease-out;
      }

      @keyframes slideDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Stats animation */
      .stats-number {
        animation: countUp 1s ease-out;
      }

      @keyframes countUp {
        from {
          transform: scale(0.8);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }

      /* Empty state styles */
      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        animation: fadeInUp 0.8s ease-out;
      }

      .empty-illustration {
        width: 200px;
        height: 200px;
        margin: 0 auto 2rem;
        opacity: 0.7;
        animation: float 3s ease-in-out infinite;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      /* Enhanced delete button */
      .delete-btn {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      }
      .delete-btn:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
      }

      /* Enhanced download button */
      .download-btn {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      }
      .download-btn:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
      }

      /* Profile avatar placeholder */
      .profile-avatar {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.8;
        }
      }
    </style>
  </head>
  <body class="font-sans text-white">
    <!-- Mobile Menu Button -->
    <button
      id="mobileMenuBtn"
      class="md:hidden fixed top-4 left-4 z-60 glass p-2 rounded-lg"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar glass shadow-2xl">
      <div class="p-6">
        <!-- Brand Logo -->
        <div class="mb-8 text-center">
          <h1 class="text-3xl font-bold logo-text mb-2">Eikona</h1>
          <p class="text-xs text-gray-400 uppercase tracking-widest">
            Visual Stories
          </p>
        </div>

        <!-- Navigation -->
        <nav class="space-y-4 mb-8">
          <a
            href="/dashboard"
            class="flex items-center space-x-3 p-3 rounded-lg hover:bg-indigo-500 hover:bg-opacity-10 transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m8 5l4-4 4 4"
              ></path>
            </svg>
            <span>Dashboard</span>
          </a>
          <a
            href="/create-post"
            class="flex items-center space-x-3 p-3 rounded-lg hover:bg-indigo-500 hover:bg-opacity-10 transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              ></path>
            </svg>
            <span>Create Post</span>
          </a>
          <a
            href="/profile"
            class="flex items-center space-x-3 p-3 rounded-lg bg-indigo-500 text-white"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
            <span>Profile</span>
          </a>
        </nav>

        <!-- Profile Stats Quick View -->
        <div class="glass p-4 rounded-lg mb-8">
          <h3
            class="text-sm font-semibold text-indigo-300 mb-3 flex items-center"
          >
            <svg
              class="w-4 h-4 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
            Your Activity
          </h3>
          <div class="text-center">
            <div
              class="text-2xl font-bold text-indigo-400 stats-number"
              id="sidebarTotalPosts"
            >
              <%= myPosts.length %>
            </div>
            <div class="text-xs text-gray-400">Total Posts</div>
          </div>
        </div>

        <!-- Logout -->
        <a
          href="/logout"
          class="flex items-center space-x-3 p-3 rounded-lg bg-red-500 hover:bg-red-600 transition text-white"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            ></path>
          </svg>
          <span>Logout</span>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <div class="max-w-6xl mx-auto">
        <!-- Profile Header -->
        <section class="profile-header glass p-8 rounded-2xl shadow-2xl mb-8">
          <div
            class="flex flex-col md:flex-row items-center md:items-start space-y-6 md:space-y-0 md:space-x-8"
          >
            <!-- Profile Avatar -->
            <div
              class="profile-avatar rounded-full flex items-center justify-center flex-shrink-0"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>

            <!-- Profile Info -->
            <div class="flex-1 text-center md:text-left">
              <h1
                class="text-4xl font-bold mb-3 bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent"
              >
                <%= user.name %>
              </h1>
              <div
                class="flex justify-center md:justify-start items-center space-x-2 text-gray-300 mb-4"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                <span><%= user.email %></span>
              </div>
              <p class="text-gray-400">
                Creating and sharing visual stories on Eikona
              </p>
            </div>

            <!-- Stats -->
            <div class="flex space-x-8 text-center">
              <div class="glass p-4 rounded-xl">
                <div
                  class="text-3xl font-bold text-indigo-400 stats-number"
                  id="totalPosts"
                >
                  <%= myPosts.length %>
                </div>
                <div class="text-sm text-gray-400">Posts</div>
              </div>
              <div class="glass p-4 rounded-xl">
                <div class="text-3xl font-bold text-purple-400 stats-number">
                  <%= new Date().getFullYear() - new Date(user.createdAt ||
                  Date.now()).getFullYear() || 0 %>+
                </div>
                <div class="text-sm text-gray-400">Years</div>
              </div>
            </div>
          </div>
        </section>

        <!-- My Posts Section -->
        <section>
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold flex items-center">
              <svg
                class="w-8 h-8 mr-3 text-indigo-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 11H5m14-7H5m14 14H5"
                ></path>
              </svg>
              My Creative Journey
            </h2>
            <% if (myPosts.length > 0) { %>
            <div class="glass px-4 py-2 rounded-lg">
              <span class="text-sm text-gray-300">
                <span class="font-semibold text-indigo-400"
                  ><%= myPosts.length %></span
                >
                <%= myPosts.length === 1 ? 'post' : 'posts' %> created
              </span>
            </div>
            <% } %>
          </div>

          <% if (myPosts.length > 0) { %>
          <div class="posts-grid">
            <% myPosts.forEach((post, index) => { %>
            <div
              class="post-card glass p-6 rounded-2xl shadow-lg"
              style="animation-delay: 0.1s"
            >
              <% if (post.imgUrl) { %>
              <div class="relative overflow-hidden rounded-xl mb-4">
                <img
                  src="<%= post.imgUrl %>"
                  alt="Post Image"
                  class="post-image"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"
                ></div>
              </div>
              <% } else { %>
              <div class="image-wrapper"></div>
              <% } %>

              <h3 class="text-xl font-bold mb-3 text-gray-100 leading-tight">
                <%= post.content %>
              </h3>
              <div class="flex items-center text-sm text-gray-400 mb-6">
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
                <%= new Date(post.date).toLocaleString() %>
              </div>

              <div class="flex space-x-3">
                <% if (post.imgUrl) { %>
                <a
                  href="javascript:void(0);"
                  onclick="downloadImage('<%= post.imgUrl %>', '<%= post.content.substring(0, 20) %>')"
                  title="Download post image"
                  class="action-btn download-btn flex-1 px-4 py-2 text-white rounded-lg text-sm font-medium flex items-center justify-center space-x-2 transition-all duration-200"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  <span>Download</span>
                </a>
                <% } %>
                <button
                  onclick="openDeleteModal('<%= post._id %>')"
                  class="action-btn delete-btn flex-1 px-4 py-2 text-white rounded-lg text-sm font-medium flex items-center justify-center space-x-2 transition-all duration-200"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    ></path>
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <!-- Empty State -->
          <div class="empty-state glass p-8 rounded-2xl">
            <div class="empty-illustration">
              <svg
                class="w-full h-full text-indigo-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
            </div>

            <h3 class="text-3xl font-semibold text-gray-200 mb-4">
              Your Canvas Awaits
            </h3>
            <p
              class="text-gray-400 mb-8 max-w-md mx-auto leading-relaxed text-lg"
            >
              You haven't created any posts yet. Start your creative journey and
              share your unique visual stories with the Eikona community.
            </p>

            <a
              href="/create-post"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl shadow-xl transition-all duration-300 transform hover:scale-105"
            >
              <svg
                class="w-6 h-6 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"
                ></path>
              </svg>
              Create Your First Post
            </a>
          </div>
          <% } %>
        </section>
      </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div
      id="deleteModal"
      class="modal fixed inset-0 z-50 hidden flex items-center justify-center p-4"
    >
      <div class="modal-content rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div class="text-center">
          <div
            class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-6"
          >
            <svg
              class="h-8 w-8 text-red-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-4">Delete Post?</h3>
          <p class="text-gray-300 mb-8 leading-relaxed">
            This action cannot be undone. Your post will be permanently removed
            from Eikona.
          </p>
          <div class="flex space-x-4">
            <button
              id="confirmDelete"
              class="flex-1 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 transform hover:scale-105"
            >
              Yes, Delete
            </button>
            <button
              id="cancelDelete"
              class="flex-1 glass text-gray-300 hover:text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById("mobileMenuBtn");
      const sidebar = document.getElementById("sidebar");
      mobileMenuBtn.addEventListener("click", () => {
        sidebar.classList.toggle("open");
      });

      // Download functionality
      async function downloadImage(imageUrl, filename) {
        try {
          // Show loading state
          const button = event.target.closest(".download-btn");
          const originalContent = button.innerHTML;
          button.innerHTML = `
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          `;
          button.disabled = true;

          // Fetch the image
          const response = await fetch(imageUrl);
          const blob = await response.blob();

          // Create download link
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `eikona-${filename.replace(
            /[^a-zA-Z0-9]/g,
            "-"
          )}-${Date.now()}.jpg`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          window.URL.revokeObjectURL(url);

          // Show success feedback
          button.innerHTML = `
            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          `;

          // Reset button after 2 seconds
          setTimeout(() => {
            button.innerHTML = originalContent;
            button.disabled = false;
          }, 2000);
        } catch (error) {
          console.error("Download failed:", error);

          // Show error feedback
          button.innerHTML = `
            <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          `;

          // Reset button after 2 seconds
          setTimeout(() => {
            button.innerHTML = originalContent;
            button.disabled = false;
          }, 2000);

          // Fallback: open image in new tab
          window.open(imageUrl, "_blank");
        }
      }

      // Delete modal functionality
      let postIdToDelete = null;
      function openDeleteModal(id) {
        postIdToDelete = id;
        document.getElementById("deleteModal").classList.remove("hidden");
        document.body.style.overflow = "hidden"; // Prevent background scrolling
      }

      document.getElementById("cancelDelete").addEventListener("click", () => {
        document.getElementById("deleteModal").classList.add("hidden");
        document.body.style.overflow = "auto"; // Re-enable scrolling
        postIdToDelete = null;
      });

      document
        .getElementById("confirmDelete")
        .addEventListener("click", async () => {
          if (postIdToDelete) {
            // Show loading state
            const btn = document.getElementById("confirmDelete");
            const originalText = btn.innerHTML;
            btn.innerHTML = `
            <svg class="w-4 h-4 mr-2 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Deleting...
          `;
            btn.disabled = true;

            try {
              const res = await fetch(`/posts/${postIdToDelete}`, {
                method: "DELETE",
              });
              if (res.ok) {
                location.reload();
              } else {
                throw new Error("Failed to delete");
              }
            } catch (error) {
              btn.innerHTML = originalText;
              btn.disabled = false;
              alert("Failed to delete post. Please try again.");
            }
          }
        });

      // Close modal when clicking outside
      document.getElementById("deleteModal").addEventListener("click", (e) => {
        if (e.target.id === "deleteModal") {
          document.getElementById("deleteModal").classList.add("hidden");
          document.body.style.overflow = "auto";
          postIdToDelete = null;
        }
      });

      // Close sidebar when clicking outside on mobile
      document.addEventListener("click", (e) => {
        if (window.innerWidth <= 768) {
          if (
            !sidebar.contains(e.target) &&
            !mobileMenuBtn.contains(e.target)
          ) {
            sidebar.classList.remove("open");
          }
        }
      });
    </script>
  </body>
</html>
